{
  "name": "zepul-os",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "baslat": "tsx sunucu/orkestra.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "tip": "tsc -p .",
    "denetim": "npm run tip && npm test",
    "rapor": "node araclar/rapor.mjs --saat 6",
    "ilerleme": "node araclar/ilerleme.mjs",
    "ozet": "node araclar/ozet.mjs",
    "merkez": "node araclar/komut-merkezi.mjs",
    "kapat": "node -e \"const p=require('path'),e=process.env,d=e.LOCALAPPDATA?p.join(e.LOCALAPPDATA,'zepul-os'):p.join(require('os').homedir(),'.zepul-os');const u=new URL(require('fs').readFileSync(p.join(d,'panel-url.txt'),'utf8').trim());fetch(new URL('/api/kapat',u),{method:'POST',headers:{'x-token':u.searchParams.get('t')}}).then(r=>console.log('kapat:',r.status),e=>console.error('sunucuya ulaşılamadı:',e.message))\""
  },
